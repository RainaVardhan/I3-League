{
  "$schema": "node_modules/wrangler/config-schema.json",
  // PUBLIC site (git branch `main`). Deploy with: npm run deploy
  // Named i3league-app because a Worker called `i3league` already serves the
  // old static coming-soon page at i3league.com. Move the domain over when ready.
  "name": "i3league-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep variables and secrets typed into the Cloudflare dashboard. Without this,
  // every deploy deletes dashboard variables that are not listed in this file.
  "keep_vars": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "i3league-app" }],
  // Private file storage for uploads (see src/lib/storage.ts). Create the
  // bucket once in the Cloudflare dashboard (R2) before deploying.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "i3league-uploads" }],
  "unsafe": {
    "bindings": [
      { "name": "RL_STAGE", "type": "ratelimit", "namespace_id": "101", "simple": { "limit": 120, "period": 60 } },
      { "name": "RL_JOURNAL", "type": "ratelimit", "namespace_id": "102", "simple": { "limit": 20, "period": 60 } },
      { "name": "RL_TEAM", "type": "ratelimit", "namespace_id": "103", "simple": { "limit": 20, "period": 60 } },
      { "name": "RL_UPLOAD", "type": "ratelimit", "namespace_id": "104", "simple": { "limit": 10, "period": 60 } }
    ]
  },
  "observability": { "enabled": true },

  "env": {
    // TESTING site (git branch `testing`). Deploy with:
    //   npm run deploy:testing
    // Separate Worker, separate bucket. Keep it private with Cloudflare Access.
    "testing": {
      "name": "i3league-testing",
      "keep_vars": true,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "i3league-testing" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "i3league-uploads-testing" }],
      "unsafe": {
        "bindings": [
          { "name": "RL_STAGE", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
          { "name": "RL_JOURNAL", "type": "ratelimit", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
          { "name": "RL_TEAM", "type": "ratelimit", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } },
          { "name": "RL_UPLOAD", "type": "ratelimit", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } }
        ]
      },
      "observability": { "enabled": true }
    }
  }
}
