# Copy to .env (local) or set these as secrets in Cloudflare. Never commit real values.
# Each environment (public site, testing site) needs its OWN Supabase project.

# Database (Supabase Postgres). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Supabase project keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Captcha (Cloudflare Turnstile) site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Which site is this? (see docs/ENVIRONMENTS.md) ---
# PUBLIC site (main):   leave PLATFORM_OPEN unset and list who may log in.
# TESTING site:         PLATFORM_OPEN=true (everything works), ALLOWED_EMAILS not needed.
PLATFORM_OPEN=
ALLOWED_EMAILS=
